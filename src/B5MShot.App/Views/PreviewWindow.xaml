<Window x:Class="B5MShot.App.Views.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактор — B5MShot" Icon="/Assets/logo.png" Width="1100" Height="760" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#161F30" PreviewKeyDown="Window_KeyDown">
<Window.Resources><Style x:Key="HudAction" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#EAF1FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77B9FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="HudTool" TargetType="ToggleButton"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#EAF1FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77B9FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
<Grid x:Name="Root">
<Grid.Resources>
 <Style TargetType="Slider">
  <Setter Property="Height" Value="22"/><Setter Property="Background" Value="#334259"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid VerticalAlignment="Center"><Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" Margin="7,0"/>
    <Track x:Name="PART_Track" Height="20" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F0F6FF" Stroke="#A7C9FF" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</Grid.Resources>
<Image x:Name="DesktopImage" Stretch="Fill" Visibility="Collapsed"/><Border x:Name="DesktopDim" Background="#70060D18" Visibility="Collapsed"/>
<Grid x:Name="EditorStage" Margin="24,90,24,75"><Viewbox x:Name="ImageView" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid x:Name="ImageCanvas" ClipToBounds="True"><Image x:Name="PreviewImage" Stretch="Fill"/><Canvas x:Name="AnnotationCanvas" Background="Transparent" Cursor="Cross" MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown" MouseMove="AnnotationCanvas_MouseMove" MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"/></Grid></Viewbox></Grid>
<Canvas x:Name="InlineStage" Visibility="Collapsed"/>
<StackPanel x:Name="HudHost" HorizontalAlignment="Center" VerticalAlignment="Top">
<Border x:Name="HudBar" Background="#080A0E" CornerRadius="0,0,24,24" Padding="14,10">
<StackPanel Orientation="Horizontal" x:Name="HudActions"><Grid><Canvas IsHitTestVisible="False"><Border Width="40" Height="40" Background="#237FFA" CornerRadius="12"><Border.RenderTransform><TranslateTransform x:Name="ToolIndicator" X="2"/></Border.RenderTransform></Border></Canvas><StackPanel x:Name="ToolPanel" Orientation="Horizontal"><ToggleButton x:Name="PenToolButton" Style="{StaticResource HudTool}" Tag="Pen" Content="&#xE70F;" ToolTip="Карандаш" AutomationProperties.Name="Карандаш" IsChecked="true" Click="ToolButton_Click"/>
<ToggleButton  Style="{StaticResource HudTool}" Tag="Line" Content="&#xE738;" ToolTip="Линия" AutomationProperties.Name="Линия" IsChecked="false" Click="ToolButton_Click"/>
<ToggleButton Style="{StaticResource HudTool}" Tag="Arrow" ToolTip="Стрелка" AutomationProperties.Name="Стрелка" IsChecked="false" Click="ToolButton_Click"><Path Data="M 2,18 L 18,2 M 7,2 L 18,2 L 18,13" Stroke="#EAF1FF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/></ToggleButton>
<ToggleButton  Style="{StaticResource HudTool}" Tag="Rectangle" Content="&#xE739;" ToolTip="Рамка" AutomationProperties.Name="Рамка" IsChecked="false" Click="ToolButton_Click"/>
<ToggleButton  Style="{StaticResource HudTool}" Tag="Text" Content="&#xE8D2;" ToolTip="Текст" AutomationProperties.Name="Текст" IsChecked="false" Click="ToolButton_Click"/>
<ToggleButton  Style="{StaticResource HudTool}" Tag="Blur" Content="&#xE80A;" ToolTip="Мозаика" AutomationProperties.Name="Мозаика" IsChecked="false" Click="ToolButton_Click"/></StackPanel></Grid>
<Border Width="1" Height="22" Background="#35FFFFFF" Margin="8,0"/>
<Button Style="{StaticResource HudAction}" ToolTip="Цвет и толщина" AutomationProperties.Name="Цвет и толщина" Click="PaletteButton_Click"><Ellipse x:Name="ColorDot" Width="10" Height="10" Stroke="#DDFFFFFF" StrokeThickness="1" Fill="#ED4A5A"/></Button>
<Border Width="1" Height="22" Background="#35FFFFFF" Margin="8,0"/><Button  Style="{StaticResource HudAction}" Content="&#xE7A7;" ToolTip="Отменить · Ctrl+Z" AutomationProperties.Name="Отменить · Ctrl+Z" Click="UndoButton_Click"/>
<Button  Style="{StaticResource HudAction}" Content="&#xE74E;" ToolTip="Сохранить · Ctrl+S" AutomationProperties.Name="Сохранить · Ctrl+S" Click="SaveButton_Click"/>
<Button  Style="{StaticResource HudAction}" Content="&#xE8C8;" ToolTip="Копировать · Ctrl+C" AutomationProperties.Name="Копировать · Ctrl+C" Click="CopyButton_Click"/>
<Button x:Name="UploadButton" Background="#1677EF" Style="{StaticResource HudAction}" Content="&#xE898;" ToolTip="Опубликовать" AutomationProperties.Name="Опубликовать" Click="UploadButton_Click"/>
<Button  Style="{StaticResource HudAction}" Content="&#xE711;" ToolTip="Закрыть · Esc" AutomationProperties.Name="Закрыть · Esc" Click="CloseEditor_Click"/></StackPanel></Border>
<Border x:Name="PaletteClip" Width="330" Height="0" ClipToBounds="True" HorizontalAlignment="Center" Background="#080A0E" CornerRadius="0,0,26,26" IsHitTestVisible="False">
<StackPanel x:Name="PaletteContent" Margin="18,10,18,18" Opacity="0" IsEnabled="False">
<DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Width="26" Height="26" Style="{StaticResource HudAction}" Content="&#xE711;" Click="PaletteButton_Click" ToolTip="Закрыть палитру"/><TextBlock Text="Цвет и толщина" Foreground="White" VerticalAlignment="Center" FontSize="13"/></DockPanel>
<Grid x:Name="SvField" Height="125" MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp" Cursor="Cross">
<Border x:Name="HueSurface" Background="Red"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border><Canvas IsHitTestVisible="False" ClipToBounds="True"><Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2"/></Canvas>
</Grid>
<Grid Margin="0,12"><Border Height="8" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red"/><GradientStop Color="Yellow" Offset=".167"/><GradientStop Color="Lime" Offset=".333"/><GradientStop Color="Cyan" Offset=".5"/><GradientStop Color="Blue" Offset=".667"/><GradientStop Color="Magenta" Offset=".833"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border><Slider x:Name="HueSlider" Background="Transparent" Minimum="0" Maximum="359" Value="354" ValueChanged="HueChanged" ToolTip="Цветовой тон" AutomationProperties.Name="Цветовой тон"/></Grid>
<DockPanel><TextBlock Text="HEX" Foreground="#B2C2DB" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="HexText" Text="#ED4A5A" LostKeyboardFocus="HexCommitted" KeyDown="HexKeyDown" AutomationProperties.Name="Цвет HEX"/></DockPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"><Button Width="25" Height="25" Margin="5" Padding="0" Background="#ED4A5A" Tag="#ED4A5A" ToolTip="#ED4A5A" Click="ColorButton_Click"/><Button Width="25" Height="25" Margin="5" Padding="0" Background="#F6C85F" Tag="#F6C85F" ToolTip="#F6C85F" Click="ColorButton_Click"/><Button Width="25" Height="25" Margin="5" Padding="0" Background="#5CD39B" Tag="#5CD39B" ToolTip="#5CD39B" Click="ColorButton_Click"/><Button Width="25" Height="25" Margin="5" Padding="0" Background="#5DA9FF" Tag="#5DA9FF" ToolTip="#5DA9FF" Click="ColorButton_Click"/><Button Width="25" Height="25" Margin="5" Padding="0" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="#FFFFFF" Click="ColorButton_Click"/><Button Width="25" Height="25" Margin="5" Padding="0" Background="#151D29" Tag="#151D29" ToolTip="#151D29" Click="ColorButton_Click"/></StackPanel>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Толщина" Foreground="#D1DCEE" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider Grid.Column="1" x:Name="StrokeSlider" Minimum="1" Maximum="24" Value="4" IsSnapToTickEnabled="True" ValueChanged="StrokeChanged" AutomationProperties.Name="Толщина линии"/><TextBlock Grid.Column="2" x:Name="StrokeValue" Text="4 px" Width="40" Foreground="White" Margin="10,0,0,0"/></Grid>
</StackPanel></Border></StackPanel>
<Border x:Name="StatusPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" Padding="16,10" Background="#ED101723" CornerRadius="16" MaxWidth="650"><StackPanel><TextBlock x:Name="StatusText" Text="Выберите инструмент и рисуйте по снимку" Foreground="#D3DEEF" TextWrapping="Wrap"/><TextBlock x:Name="ImageSizeText" Foreground="#9DAEC8" FontSize="11"/><TextBlock x:Name="LinkText" Visibility="Collapsed" Foreground="#7CB6FF" Cursor="Hand" MouseLeftButtonUp="LinkText_MouseLeftButtonUp"/></StackPanel></Border>
</Grid></Window>
