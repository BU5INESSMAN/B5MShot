<Window x:Class="B5MShot.App.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Cursor="Cross" Background="Black">
    <Grid x:Name="CaptureArea" MouseLeftButtonDown="CaptureArea_MouseLeftButtonDown" MouseMove="CaptureArea_MouseMove" MouseLeftButtonUp="CaptureArea_MouseLeftButtonUp">
        <Image x:Name="ScreenshotImage" Stretch="Fill" />
        <Path x:Name="DimLayer" Fill="#99000000" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed" Stroke="#9D86FF" StrokeThickness="2" Fill="#08FFFFFF" />
            <Border x:Name="SizeBadge" Visibility="Collapsed" Background="#E6161B22" CornerRadius="5" Padding="7,4">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Background="#F0222837" BorderBrush="#596883" BorderThickness="1" CornerRadius="12" Padding="12,8" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Width="24" Height="24" Margin="0,0,9,0" />
                <TextBlock Text="Выделите область  •  Esc — отмена" Foreground="White" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
