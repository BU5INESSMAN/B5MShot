<Window x:Class="B5MShot.App.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:B5MShot.App.Controls"
        Title="Выделение области — B5MShot" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Cursor="Cross" Background="Black">
    <Grid x:Name="CaptureArea" MouseLeftButtonDown="CaptureArea_MouseLeftButtonDown" MouseMove="CaptureArea_MouseMove" MouseLeftButtonUp="CaptureArea_MouseLeftButtonUp">
        <Image x:Name="ScreenshotImage" Stretch="Fill" />
        <Path x:Name="DimLayer" Fill="#70060D18" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <motion:SelectionOutline x:Name="SelectionRectangle" Visibility="Collapsed" />
            <Border x:Name="SizeBadge" Visibility="Collapsed" Background="#F0101722" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="9" Padding="9,5">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <motion:EdgeSurface x:Name="SelectionHud" Reveal="0" CollapsedWidth="130" CollapsedHeight="8" Width="350" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#080A0E" CornerRadius="0,0,24,24" Padding="22,12" IsHitTestVisible="False">
            <StackPanel x:Name="HintContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="24" Height="24" Margin="0,0,9,0" />
                <TextBlock Text="Выделите область  •  Esc — отмена" Foreground="White" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </motion:EdgeSurface>
    </Grid>
</Window>
