<Window x:Class="B5MShot.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление B5MShot" Icon="/Assets/logo.png"
        Width="460" Height="510" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True">
    <Grid Margin="14">
        <Border Background="{StaticResource ShellGradientBrush}" BorderBrush="#53617A" BorderThickness="1" CornerRadius="24" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#080A10" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" Background="#34405A" BorderBrush="#5F6D8A" BorderThickness="1">
                        <Image Source="/Assets/logo.png" Width="38" Height="38" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Доступно обновление" Foreground="White" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Новая версия B5MShot готова" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Width="34" Height="34" Padding="0" FontSize="19" Click="LaterButton_Click" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Установлена" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock x:Name="CurrentVersionText" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" Foreground="#7D8BA6" FontSize="24" Margin="20,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Доступна" Foreground="#75C6FF" FontSize="11" />
                            <TextBlock x:Name="NewVersionText" Foreground="#91D2FF" FontSize="17" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="Что нового" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="1,20,0,8" />
                <Border Grid.Row="3" Background="#171C28" BorderBrush="#374157" BorderThickness="1" CornerRadius="12" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotesText" Foreground="#C5CDDC" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Позже" Padding="16,11" Click="LaterButton_Click" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Скачать обновление" Padding="16,11" Click="DownloadButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
