<Window x:Class="B5MShot.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:motion="clr-namespace:B5MShot.App.Controls"
 Title="B5MShot" Icon="/Assets/logo.png" Width="426" Height="748"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
 Topmost="True" AllowsTransparency="True" Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style x:Key="EdgeChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="motion:Motion.Interactive" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Padding="5,10"><ContentPresenter x:Name="MotionContent" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1669D5"/><Setter TargetName="Surface" Property="BorderBrush" Value="#81BFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#12FFFFFF"/><Setter Property="BorderBrush" Value="#20FFFFFF"/>
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent" Height="46"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center"/>
     <Border x:Name="Track" Grid.Column="1" Height="26" Width="44" CornerRadius="13" Background="#687688" VerticalAlignment="Center">
      <Ellipse x:Name="SwitchThumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="SwitchOffset"/></Ellipse.RenderTransform></Ellipse>
     </Border>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2088FA"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="14" x:Name="Shell">
  <Border Background="{StaticResource ShellGradientBrush}" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="30" Padding="22">
   <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity=".28" Color="#091727"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
     <Image Source="/Assets/logo.png" Width="46" Height="46"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock Text="B5MShot" Foreground="White" FontSize="23" FontWeight="SemiBold" motion:Motion.TextReveal="True"/>
      <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="6" Height="6" Fill="#6EE7BE" Margin="0,0,6,0"/><TextBlock Text="Рядом, когда нужен" Foreground="#C3D1E1" FontSize="11"/></StackPanel>
     </StackPanel>
     <Button Grid.Column="2" Content="×" Style="{StaticResource QuietButton}" Width="30" Height="30" Padding="0" FontSize="20" ToolTip="Скрыть в трей" AutomationProperties.Name="Скрыть в трей" Click="CloseButton_Click"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Button Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Stretch" Padding="16,16" Click="CaptureButton_Click">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path Data="M0,7 V0 H7 M17,0 H24 V7 M24,17 V24 H17 M7,24 H0 V17" Stroke="White" StrokeThickness="2" Width="24" Height="24" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1"><TextBlock Text="Выделить область" FontSize="15" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Поймай главное" FontSize="11" Foreground="#E0EFFF" Margin="0,3,0,0"/></StackPanel>
        <TextBlock x:Name="AreaShortcutText" Grid.Column="2" FontSize="10" Foreground="White" VerticalAlignment="Center" MaxWidth="95" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Button>
      <Grid Margin="0,9,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Style="{StaticResource QuietButton}" Padding="8,10" Click="CaptureFullscreenButton_Click"><StackPanel><TextBlock Text="Весь экран" Foreground="White" HorizontalAlignment="Center"/><TextBlock x:Name="FullscreenShortcutText" FontSize="9" Foreground="#BECEE0" HorizontalAlignment="Center" Margin="0,3,0,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
       <Button Grid.Column="2" Style="{StaticResource QuietButton}" Padding="8,10" Click="OpenImageButton_Click"><StackPanel><TextBlock Text="Открыть файл" Foreground="White"/><TextBlock Text="PNG или JPEG" FontSize="9" Foreground="#BECEE0" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
      </Grid>
      <TextBlock Text="Панель инструментов" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8"/>
      <UniformGrid x:Name="EdgeChoices" Columns="4" Margin="-2,0,-2,8"><RadioButton Content="Сверху" Tag="Top" GroupName="HudEdge" Style="{StaticResource EdgeChoice}"/><RadioButton Content="Снизу" Tag="Bottom" GroupName="HudEdge" Style="{StaticResource EdgeChoice}"/><RadioButton Content="Слева" Tag="Left" GroupName="HudEdge" Style="{StaticResource EdgeChoice}"/><RadioButton Content="Справа" Tag="Right" GroupName="HudEdge" Style="{StaticResource EdgeChoice}"/></UniformGrid>
      <ComboBox x:Name="ToolbarMonitorBox" DisplayMemberPath="Label" SelectedValuePath="DeviceName" FontSize="11" Padding="8,5" Margin="0,0,0,6" AutomationProperties.Name="Монитор для панели инструментов"/>
      <TextBlock Text="Для открытого файла — по краю окна редактора." Foreground="#C0CEDF" FontSize="10" Margin="2,0,0,16"/>
      <TextBlock Text="Горячие клавиши" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10" motion:Motion.TextReveal="True"/>
      <Border Background="#20FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,4">
       <StackPanel>
        <Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Область" Foreground="White" VerticalAlignment="Center" FontSize="13"/><Button x:Name="AreaHotKeyButton" Grid.Column="1" Style="{StaticResource QuietButton}" Padding="8,6" VerticalAlignment="Center" FontSize="11" Click="AreaHotKeyButton_Click"/></Grid>
        <Border Height="1" Background="#20FFFFFF"/>
        <Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Весь экран" Foreground="White" VerticalAlignment="Center" FontSize="13"/><Button x:Name="FullscreenHotKeyButton" Grid.Column="1" Style="{StaticResource QuietButton}" Padding="8,6" VerticalAlignment="Center" FontSize="11" Click="FullscreenHotKeyButton_Click"/></Grid>
       </StackPanel>
      </Border>
      <TextBlock Text="Нажми на сочетание и введи своё. Delete — отключить." FontSize="10" Foreground="#C0CEDF" TextWrapping="Wrap" Margin="3,9,3,15"/>
      <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,2">
       <CheckBox x:Name="StartWithWindowsCheckBox" Checked="AutoStartToggleChanged" Unchecked="AutoStartToggleChanged" Loaded="AutoStartToggleChanged" AutomationProperties.Name="Запускать вместе с Windows"><StackPanel><TextBlock Text="Вместе с Windows" Foreground="White" FontSize="13"/><TextBlock Text="Тихо запускать в трее" Foreground="#BECEE0" FontSize="10" Margin="0,2,0,0"/></StackPanel></CheckBox>
      </Border>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="UpdateButton" Content="Обновления" Style="{StaticResource QuietButton}" Padding="8,9" Click="UpdateButton_Click"/>
       <Button Grid.Column="2" Content="Сообщить об ошибке" Style="{StaticResource QuietButton}" Padding="8,9" FontSize="12" Click="ReportBugButton_Click"/>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="Готов к снимку" Foreground="#B9C9DB" TextWrapping="Wrap" FontSize="11" motion:Motion.TextReveal="True"/><TextBlock x:Name="VersionText" Foreground="#A6BAD1" FontSize="10" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Сохранить" Padding="19,10" Click="SaveButton_Click"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
